# Chaîne de connexion PostgreSQL (Render la fournit automatiquement)
DATABASE_URL=postgres://user:password@localhost:5432/monblog
# Secret utilisé pour signer les cookies de session
SESSION_SECRET=change-moi-par-une-chaine-secrete
# "development" affiche le détail des erreurs
NODE_ENV=development
# Force la désactivation de SSL pour une base locale (facultatif)
# PGSSL=false
