<%- include('layouts/header') %>
<body>
  <%- include('layouts/navbar') %>

  <header class="masthead">
    <div class="overlay"></div>
    <div class="container px-4 px-lg-5">
      <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">
          <div class="page-heading">
            <h1>Modifier l'article</h1>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7">
        <form action="/posts/<%= blogpost._id %>/edit" method="POST">
          <div class="form-group mb-3">
            <label for="title" class="form-label">Titre</label>
            <input type="text" class="form-control" id="title" name="title" value="<%= blogpost.title %>" />
          </div>

          <div class="form-group mb-3">
            <label for="body" class="form-label">Description</label>
            <textarea rows="5" class="form-control" id="body" name="body"><%= blogpost.body %></textarea>
          </div>

          <div class="form-group mb-3">
            <label for="imageFile" class="form-label">Remplacer l'image (optionnel)</label>
            <% if (blogpost.image) { %>
              <div class="mb-2">
                <img src="<%= blogpost.image %>" class="img-fluid rounded" alt="Image actuelle" style="max-height: 180px;" />
              </div>
            <% } %>
            <input type="file" class="form-control" id="imageFile" accept="image/*" />
            <input type="hidden" name="image" id="image" />
            <div class="form-text">Image encodée en base64 (2 Mo maximum).</div>
          </div>

          <button type="submit" class="btn btn-primary">Enregistrer</button>
          <a href="/post/<%= blogpost._id %>" class="btn btn-outline-secondary">Annuler</a>
        </form>
      </div>
    </div>
  </div>

  <hr />

  <%- include('layouts/footer') %>
  <%- include('layouts/scripts') %>
</body>
</html>
